{
  "name": "victory-ui",
  "private": true,
  "version": "0.1.0",
  "description": "VictoryCTO team front end (projects, tasks, time tracker) for Invoice Ninja v5",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:remote": "vite --mode remote",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.11",
    "@mui/x-data-grid-pro": "8.29.5",
    "@tanstack/react-query": "5.81.5",
    "@victory/workspace": "file:vendor/victory-workspace-0.2.1.tgz",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.34",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "msw": "2.10.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.4.5",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "mock-public"
    ]
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
